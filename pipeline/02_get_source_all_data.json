{
	"name": "02_get_source_all_data",
	"properties": {
		"activities": [
			{
				"name": "FE_Source_Table_Load",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"activities": [
						{
							"name": "ACT_SRC_Northwind_Csv",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SourceDB",
									"type": "DatasetReference",
									"parameters": {
										"source_table_name": {
											"value": "@pipeline().parameters.source_table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SRC_Northwind_Csv",
									"type": "DatasetReference",
									"parameters": {
										"RelativeUrl": {
											"value": "@pipeline().parameters.RelativeUrl",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"RelativeUrl": {
				"type": "String",
				"defaultValue": "customers.csv"
			},
			"source_table_name": {
				"type": "String",
				"defaultValue": "customers"
			},
			"table_list": {
				"type": "array",
				"defaultValue": [
					{
						"file_name": "customers.csv",
						"table_name": "Customer"
					},
					{
						"file_name": "products.csv",
						"table_name": "Product"
					},
					{
						"file_name": "orders.csv",
						"table_name": "Orders"
					},
					{
						"file_name": "suppliers.csv",
						"table_name": "Supplier"
					},
					{
						"file_name": "categories.csv",
						"table_name": "Category"
					},
					{
						"file_name": "employees.csv",
						"table_name": "Employee"
					},
					{
						"file_name": "shippers.csv",
						"table_name": "Shipper"
					}
				]
			}
		},
		"folder": {
			"name": "99_SourceDataChecks"
		},
		"annotations": []
	}
}